{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "auth": {
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "${LLM_MODEL}"
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "dmPolicy": "allowlist",
      "allowFrom": ["${TELEGRAM_ALLOWED_USER_ID}"]
    }
  },
  "tools": {
    "web": {
      "search": {
        "provider": "perplexity",
        "perplexity": {
          "apiKey": "${PERPLEXITY_API_KEY}"
        }
      }
    }
  },
  "browser": {
    "enabled": true,
    "headless": true,
    "noSandbox": true,
    "executablePath": "/opt/pw-browsers/chromium-1208/chrome-linux/chrome"
  },
  "cron": {
    "enabled": true,
    "maxConcurrentRuns": 2
  },
  "plugins": {
    "allow": [
      "telegram"
    ],
    "slots": {},
    "entries": {
      "hindsight-openclaw": {
        "enabled": false
      },
      "memory-core": {
        "enabled": true
      },
      "memory-lancedb": {
        "enabled": true,
        "config": {
          "embedding": {
            "apiKey": "${OPENAI_EMBEDDING_KEY}"
          }
        }
      }
    }
  }
}
